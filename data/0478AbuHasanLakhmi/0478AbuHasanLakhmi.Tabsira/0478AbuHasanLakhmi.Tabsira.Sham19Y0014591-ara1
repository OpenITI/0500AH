# 1 - (ف) = نسخة فرنسا رقم (1071)
# 2 - (ت) = نسخة تازة رقم (234 & 243)
# 3 - (ر) = نسخة الحمزوية رقم (110) PageV12P5541 # بسم الله الرحمن الرحيم
